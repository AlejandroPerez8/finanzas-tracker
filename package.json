{
  "name": "finanzas-tracker",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "PWA de finanzas personales con ingesta de Bancolombia y módulo de tarjetas.",
  "scripts": {
    "start": "node integraciones/apps_script/mock/server.js --static",
    "mock": "node integraciones/apps_script/mock/server.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"js/domain/**\" --test-coverage-include=\"js/services/**\" --test-coverage-lines=85 --test-coverage-functions=85 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:smoke": "node tests/smoke/smoke.mjs",
    "lint": "eslint js tests integraciones/apps_script/mock",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" \"integraciones/apps_script/mock/*.js\"",
    "check": "npm run lint && npm run test:coverage"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "prettier": "3.6.2"
  }
}
